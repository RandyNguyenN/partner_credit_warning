<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_partner_credit_settings_form" model="ir.ui.view">
        <field name="name">res.partner.credit.settings.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <!-- Add credit settings in Sales &amp; Purchases tab -->
            <xpath expr="//page[@name='sales_purchases']" position="inside">
                <group string="Credit Warning">
                    <field name="credit_limit"/>
                    <field name="credit_mode"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
